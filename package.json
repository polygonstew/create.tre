{
  "name": "create-tre",
  "icon": "icon.png",
  "displayName": "create.tre",
  "description": "create files and folders from a tree text",
  "version": "0.0.2",
  "license": "MIT",
  "publisher": "polygonstew",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
  "type": "git",
  "url": "https://github.com/polygonstew/create.tre"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "tre",
        "extensions": [".tre"],
        "aliases": ["tre"]
      }
    ],
    "commands": [
      {
        "command": "createTre.createFromFile",
        "title": "create.tre: Create From File"
      },
      {
        "command": "createTre.createFromSelection",
        "title": "create.tre: Create From Selection"
      },
      {
        "command": "createTre.previewFromSelection",
        "title": "create.tre: Preview From Selection"
      },
      {
        "command": "createTre.folderToTree",
        "title": "create.tre: Folder To Tree"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "createTre.createFromFile",
          "when": "resourceExtname == .tre",
          "group": "createTre"
        },
        {
          "command": "createTre.folderToTree",
          "when": "explorerResourceIsFolder",
          "group": "createTre@1"
        }
      ],
      "editor/context": [
        {
          "command": "createTre.createFromSelection",
          "when": "editorHasSelection",
          "group": "createTre"
        },
        {
          "command": "createTre.previewFromSelection",
          "when": "editorHasSelection",
          "group": "createTre"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0"
  }
}