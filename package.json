{
  "name": "create-tre",
  "icon": "icon.png",
  "displayName": "create.tre",
  "description": "create files and folders from a tree text",
  "version": "0.0.3",
  "license": "MIT",
  "publisher": "polygonstew",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polygonstew/create.tre"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "tree",
    "scaffold",
    "filesystem",
    "folder",
    "template",
    "directory"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "tre",
        "extensions": [
          ".tre"
        ],
        "aliases": [
          "tre"
        ]
      }
    ],
      "commands": [
              {
                  "command": "create.tre.folderToTree",
                  "title": "create.tre: Folder To Tree"
              },
              {
                  "command": "create.tre.createFromFile",
                  "title": "create.tre: Create From File"
              },
              {
                  "command": "create.tre.createFromSelection",
                  "title": "create.tre: Create From Selection"
              }
          ],
          "menus": {
              "explorer/context": [
                  {
                      "when": "explorerResourceIsFolder",
                      "command": "create.tre.folderToTree",
                      "group": "2_workspace"
                  },
                  {
                      "when": "resourceExtname == .tre",
                      "command": "create.tre.createFromFile",
                      "group": "2_workspace"
                  }
              ],
              "editor/context": [
                  {
                      "command": "create.tre.createFromSelection",
                      "group": "2_workspace"
            }
        ]
    }
},
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0"
  }
}
